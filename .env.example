# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Opsiyonel: siteyi sadece şifreyi bilen arkadaşlara aç (boş bırakırsan herkese açık)
SITE_PASSWORD=

# Opsiyonel: kullanıcı adından üretilen gizli e-posta adreslerinin alan adı (e-posta gönderilmez)
# NEXT_PUBLIC_AUTH_EMAIL_DOMAIN=users.fam-io.app

# Opsiyonel: sitenin tam adresi (paylaşım görselleri için). Vercel'de boş bırakılabilir.
# NEXT_PUBLIC_SITE_URL=https://fam-io.vercel.app

# Opsiyonel: Discord komutları (/dublaj, /baglan, /liderlik…). README > Discord komutları
# DISCORD_PUBLIC_KEY=Discord Developer Portal > General Information > Public Key
# SUPABASE_SERVICE_ROLE_KEY=Supabase > Project Settings > API > service_role (GİZLİ; asla NEXT_PUBLIC_ ile başlatma)
